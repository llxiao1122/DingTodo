[Unit]
Description=Read-only DWS event observer paired with the history poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=DWS_PARITY_STATE_DIR=/root/.hermes/dingtodo-parity-state
ExecStart=/usr/bin/python3 @RELEASE_DIR@/listener_engine.py --state-dir /root/.hermes/dingtalk-listener-state --mode shadow --not-before 2026-10-08T00:00:00+08:00
Restart=on-failure
RestartSec=30
KillMode=mixed
TimeoutStopSec=60
SendSIGKILL=no
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
