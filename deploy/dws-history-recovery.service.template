[Unit]
Description=One-shot configured-group DWS history recovery

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/python3 @PROJECT_DIR@/listener_engine.py --state-dir %h/.local/state/dws-history-listener --recover-once --mode production --write-ledger --allow-external-writes @CURRENT_MODEL_FLAGS@ @CURRENT_NOT_BEFORE_ARGS@
TimeoutStartSec=35min
KillMode=mixed
TimeoutStopSec=60
SendSIGKILL=no
UMask=0077
StandardOutput=journal
StandardError=journal
